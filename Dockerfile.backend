FROM python:3.12-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        util-linux \
        openssh-client \
        pv \
        pigz \
        zstd \
        lz4 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY backend/server.py /app/server.py

EXPOSE 8080
CMD ["python3", "-u", "/app/server.py"]
